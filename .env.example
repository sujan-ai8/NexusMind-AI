# NexusMind AI - Environment Variables Template
# Copy this file to .env for local development

# Environment Mode: development | staging | production
ENVIRONMENT=development
APP_NAME="NexusMind AI"
APP_VERSION="1.0.0-phase1"
DEBUG=true

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=nexusmind-super-secret-key-phase1-dev-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL for Docker/Production, SQLite supported for local testing)
# Example Postgres: postgresql+psycopg2://postgres:postgres@localhost:5432/nexusmind_ai
# Example Docker: postgresql+psycopg2://postgres:postgres@postgres:5432/nexusmind_ai
DATABASE_URL=sqlite:///./nexusmind_dev.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexusmind_ai
POSTGRES_PORT=5432

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# AWS Placeholder Configuration (Phase 1 readiness - no live connection assumed)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_DATASET_BUCKET=""

# Background Worker & Redis (Phase 1 readiness)
REDIS_URL=redis://localhost:6379/0

